{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*[Mm]agnific.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/magnific/guard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*[Mm]agnific.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/magnific/capture.py\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
